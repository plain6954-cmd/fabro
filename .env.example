DEBUG=True
# Use a unique random value of at least 50 characters. Never reuse this example.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
ALLOWED_HOSTS=127.0.0.1,localhost,10.0.2.2

# DATABASE_URL takes precedence and automatically enables PostgreSQL.
# Example: postgresql://USER:PASSWORD@HOST:5432/postgres
DATABASE_URL=
# Alternatively, enable PostgreSQL with the individual DB_* values below.
USE_POSTGRES=False
DB_NAME=postgres
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=5432

# Local Flutter web development can use broad CORS while DEBUG=True.
CORS_ALLOW_ALL_ORIGINS=True
TRUST_PROXY_HEADERS=False
CORS_ALLOWED_ORIGINS=
CORS_ALLOW_CREDENTIALS=False
CSRF_TRUSTED_ORIGINS=

# Internal accounts should normally be created by an administrator.
ALLOW_PUBLIC_REGISTRATION=False
LOGIN_MAX_ATTEMPTS=8
LOGIN_RATE_WINDOW_SECONDS=300
LOGIN_LOCKOUT_SECONDS=900

# Production security (defaults to secure values when DEBUG=False).
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000

# Local development/tests use MEDIA_ROOT. Production (DEBUG=False) enables
# Supabase automatically; set this explicitly to True in Vercel.
USE_SUPABASE_STORAGE=False
SUPABASE_URL=https://PROJECT_REF.supabase.co
# Server-side secret. Never expose it to browser code or NEXT_PUBLIC_* variables.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=fabro-leather-media
SUPABASE_SIGNED_DOWNLOAD_TTL_SECONDS=300
SUPABASE_STORAGE_HTTP_TIMEOUT_SECONDS=15
