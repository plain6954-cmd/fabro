DEBUG=True
# Use a unique random value of at least 50 characters. Never reuse this example.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
ALLOWED_HOSTS=127.0.0.1,localhost,10.0.2.2

# DATABASE_URL takes precedence and automatically enables PostgreSQL.
# Example: postgresql://USER:PASSWORD@HOST:5432/postgres
DATABASE_URL=
# Alternatively, enable PostgreSQL with the individual DB_* values below.
USE_POSTGRES=False
DB_NAME=postgres
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=5432

# Local Flutter web development can use broad CORS while DEBUG=True.
CORS_ALLOW_ALL_ORIGINS=True
TRUST_PROXY_HEADERS=False
CORS_ALLOWED_ORIGINS=
CORS_ALLOW_CREDENTIALS=False
CSRF_TRUSTED_ORIGINS=

# Internal accounts should normally be created by an administrator.
ALLOW_PUBLIC_REGISTRATION=False
LOGIN_MAX_ATTEMPTS=8
LOGIN_RATE_WINDOW_SECONDS=300
LOGIN_LOCKOUT_SECONDS=900

# Production security (defaults to secure values when DEBUG=False).
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000

# Supabase Storage (S3-compatible). When all required values are present this is
# enabled automatically; set USE_SUPABASE_STORAGE=False to force local media.
USE_SUPABASE_STORAGE=True
SUPABASE_STORAGE_ACCESS_KEY_ID=
SUPABASE_STORAGE_SECRET_ACCESS_KEY=
SUPABASE_STORAGE_BUCKET_NAME=
SUPABASE_STORAGE_REGION=
SUPABASE_STORAGE_ENDPOINT_URL=https://PROJECT_REF.storage.supabase.co/storage/v1/s3
# Optional for public buckets. Omit it to generate private, signed S3 URLs.
SUPABASE_STORAGE_PUBLIC_URL_FORMAT=https://PROJECT_REF.supabase.co/storage/v1/object/public/{bucket}/{key}

# Optional AWS S3 fallback. Objects use private, signed URLs by default.
USE_S3=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=ap-south-2
